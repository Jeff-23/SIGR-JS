NODE_ENV=development
DATABASE_URL=postgresql://usuario:clave@localhost:5433/sigr_db
JWT_SECRET=reemplazar-por-un-secreto-seguro-de-32-caracteres
JWT_EXPIRES_IN=12h
PORT=3000
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
TIME_ZONE=America/Bogota
SEED_ADMIN_PASSWORD=reemplazar-antes-de-ejecutar-el-seed
SWAGGER_ENABLED=true
METRICS_ENABLED=true
TRUST_PROXY=false
SOPORTES_STORAGE_DIR=storage/soportes

# Sprint 47 · imágenes optimizadas de productos
MEDIA_STORAGE_DIR=storage/media

# Sincronizacion hibrida Sprint 48D (deshabilitada por defecto)
SYNC_ENABLED=false
SYNC_ROLE=STANDALONE
SYNC_NODE_ID=standalone
SYNC_POLL_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
SYNC_CERTIFICATION_ENABLED=false
