generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  RESERVADA
  PENDIENTE_PAGO
  FUERA_SERVICIO
}

enum TipoPedido {
  MESA
  PARA_LLEVAR
  DOMICILIO
  MOSTRADOR
  MANUAL
}

enum OrigenVenta {
  PEDIDO
  DIRECTA
  MANUAL_CIERRE
}

enum EstadoVenta {
  PENDIENTE_PAGO
  PAGADA
  ANULADA
}

enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  FACTURADO
  CANCELADO
}

enum EstadoComanda {
  PENDIENTE
  EN_PREPARACION
  LISTA
  ENTREGADA
  CANCELADA
}

enum PrioridadComanda {
  NORMAL
  ALTA
  URGENTE
}

enum EstadoDomicilio {
  PENDIENTE_ASIGNACION
  ASIGNADO
  EN_RUTA
  ENTREGADO
  NO_ENTREGADO
  CANCELADO
}

enum AmbitoRol {
  SISTEMA
  RESTAURANTE
}

enum EstadoDocumentoElectronico {
  PREPARADO
  NUMERADO
  EN_COLA
  ENVIANDO
  ENVIADO
  ACEPTADO
  RECHAZADO
  ERROR
}

enum AmbienteDian {
  HABILITACION
  PRODUCCION
}

enum ModoOperacionDian {
  PROVEEDOR_TECNOLOGICO
  SOFTWARE_PROPIO
}

enum TipoDocumentoFiscal {
  FACTURA_VENTA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum EstadoOutboxFiscal {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  FALLIDO
}

enum TipoMetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  QR
  OTRO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum EstrategiaInventario {
  NO_CONTROLAR
  STOCK_DIRECTO
  POR_RECETA
}

enum UnidadInventario {
  UNIDAD
  GR
  KG
  ML
  L
  PORCION
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  MERMA
  DEVOLUCION
  CONSUMO_INTERNO
  REVERSO_VENTA
}

enum OrigenRegistroFactura {
  SISTEMA
  PAPEL
  DIGITACION_DIRECTA
  IMPORTADO
}

model Restaurante {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  nit           String   @unique @db.VarChar(20)
  direccion     String?  @db.VarChar(200)
  telefono      String?  @db.VarChar(20)
  correo        String?  @db.VarChar(150)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  planId Int?
  plan   Plan? @relation(fields: [planId], references: [id])

  sucursales       Sucursal[]
  usuarios         Usuario[]
  roles            Rol[]
  clientes         Cliente[]
  configuraciones  ConfiguracionRestaurante[]
  auditorias       EventoAuditoria[]
  perfilFiscal     PerfilFiscal?
  resolucionesDian ResolucionNumeracionDian[]
  registrosFactura RegistroFacturaOperativa[]

  @@index([planId])
}

model Cliente {
  id Int @id @default(autoincrement())

  tipoDocumento   String? @db.VarChar(20)
  numeroDocumento String? @db.VarChar(30)

  nombres   String  @db.VarChar(120)
  apellidos String? @db.VarChar(120)

  telefono  String? @db.VarChar(30)
  correo    String? @db.VarChar(150)
  direccion String? @db.VarChar(200)

  fechaNacimiento DateTime? @db.Date

  estado Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)

  ventas Venta[]

  @@unique([restauranteId, numeroDocumento])
  @@index([restauranteId])
  @@index([restauranteId, estado])
  @@index([restauranteId, nombres])
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  direccion String?  @db.VarChar(200)
  telefono  String?  @db.VarChar(20)
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  restauranteId    Int
  restaurante      Restaurante                @relation(fields: [restauranteId], references: [id])
  resolucionesDian ResolucionNumeracionDian[]

  usuarios              Usuario[]
  zonas                 Zona[]
  categorias            Categoria[]
  articulos             Articulo[]
  pedidos               Pedido[]
  ventas                Venta[]
  cajas                 Caja[]
  movimientosInventario MovimientoInventario[]
  configuraciones       ConfiguracionSucursal[]
  auditorias            EventoAuditoria[]
  registrosFactura      RegistroFacturaOperativa[]
  estacionesPreparacion EstacionPreparacion[]
}

// ==========================================
// SPRINT 8: CONFIGURACION OPERATIVA
// ==========================================

model ConfiguracionRestaurante {
  id            Int      @id @default(autoincrement())
  clave         String   @db.VarChar(60)
  valor         Json
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@unique([restauranteId, clave])
  @@index([restauranteId])
}

model ConfiguracionSucursal {
  id            Int      @id @default(autoincrement())
  clave         String   @db.VarChar(60)
  valor         Json
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, clave])
  @@index([sucursalId])
}

model Rol {
  id          Int     @id @default(autoincrement())
  clave       String  @unique @db.VarChar(120)
  nombre      String  @db.VarChar(50)
  descripcion String? @db.Text

  ambito        AmbitoRol
  restauranteId Int?

  restaurante Restaurante? @relation(fields: [restauranteId], references: [id], onDelete: Restrict)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@unique([restauranteId, nombre])
  @@index([ambito])
  @@index([restauranteId])
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  email     String  @unique @db.VarChar(150)
  password  String  @db.VarChar(255)
  activo    Boolean @default(true)

  rolId         Int
  restauranteId Int?
  sucursalId    Int?

  creadoEn DateTime @default(now())

  rol         Rol          @relation(fields: [rolId], references: [id])
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id])
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id])

  pedidos Pedido[]
  ventas  Venta[]

  cajasAbiertas         Caja[]                     @relation("CajaAbiertaPor")
  cajasCerradas         Caja[]                     @relation("CajaCerradaPor")
  movimientosCaja       MovimientoCaja[]
  pagosRegistrados      Pago[]
  movimientosInventario MovimientoInventario[]
  auditorias            EventoAuditoria[]          @relation("AuditoriaActor")
  mesasOcupadasManual   Mesa[]                     @relation("MesaOcupadaManualPor")
  domiciliosAsignados   Domicilio[]                @relation("DomicilioRepartidor")
  registrosFactura      RegistroFacturaOperativa[]

  @@index([restauranteId])
  @@index([sucursalId])
}

model Zona {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(50)
  estado   Boolean  @default(true)
  creadoEn DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  mesas Mesa[]
}

model Mesa {
  id                 Int        @id @default(autoincrement())
  numero             String     @db.VarChar(10)
  capacidad          Int        @default(4)
  situacion          EstadoMesa @default(LIBRE)
  estado             Boolean    @default(true)
  creadoEn           DateTime   @default(now())
  ocupacionManual    Boolean    @default(false)
  ocupadaManualEn    DateTime?
  ocupadaManualPorId Int?

  zonaId           Int
  zona             Zona     @relation(fields: [zonaId], references: [id])
  ocupadaManualPor Usuario? @relation("MesaOcupadaManualPor", fields: [ocupadaManualPorId], references: [id], onDelete: SetNull)

  pedidos Pedido[]
}

model Categoria {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(50)
  estado   Boolean  @default(true)
  creadoEn DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  productos Producto[]
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text
  precio      Decimal @db.Decimal(10, 2)

  estrategiaInventario EstrategiaInventario @default(NO_CONTROLAR)
  unidadInventario     UnidadInventario     @default(UNIDAD)
  stock                Decimal              @default(0) @db.Decimal(14, 4)

  estado   Boolean  @default(true)
  creadoEn DateTime @default(now())

  categoriaId Int
  estacionId  Int?
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  estacion    EstacionPreparacion? @relation(fields: [estacionId], references: [id], onDelete: SetNull)

  detalles              DetallePedido[]
  detallesVenta         DetalleVenta[]
  recetas               Receta[]
  movimientosInventario MovimientoInventario[]

  @@index([estacionId])
}

model EstacionPreparacion {
  id        Int      @id @default(autoincrement())
  codigo    String   @db.VarChar(40)
  nombre    String   @db.VarChar(80)
  color     String   @default("#F97316") @db.VarChar(7)
  orden     Int      @default(0)
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  productos  Producto[]
  comandas   Comanda[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId, estado])
}

model Pedido {
  id       Int          @id @default(autoincrement())
  total    Decimal      @db.Decimal(12, 2)
  tipo     TipoPedido   @default(MESA)
  estado   EstadoPedido @default(PENDIENTE)
  creadoEn DateTime     @default(now())

  idempotenciaClave String? @db.VarChar(100)
  idempotenciaHash  String? @db.VarChar(64)

  sucursalId Int
  mesaId     Int?
  usuarioId  Int

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  mesa     Mesa?    @relation(fields: [mesaId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  detalles  DetallePedido[]
  comandas  Comanda[]
  factura   Factura?
  venta     Venta?
  domicilio Domicilio?

  @@unique([sucursalId, idempotenciaClave])
  @@index([sucursalId, creadoEn])
}

model Domicilio {
  id            Int             @id @default(autoincrement())
  estado        EstadoDomicilio @default(PENDIENTE_ASIGNACION)
  destinatario  String          @db.VarChar(160)
  telefono      String          @db.VarChar(30)
  direccion     String          @db.VarChar(250)
  referencias   String?         @db.VarChar(300)
  costo         Decimal         @default(0) @db.Decimal(12, 2)
  asignadoEn    DateTime?
  enRutaEn      DateTime?
  entregadoEn   DateTime?
  observacion   String?         @db.VarChar(300)
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  pedidoId     Int      @unique
  repartidorId Int?
  pedido       Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  repartidor   Usuario? @relation("DomicilioRepartidor", fields: [repartidorId], references: [id], onDelete: SetNull)

  @@index([estado, creadoEn])
  @@index([repartidorId])
}

model DetallePedido {
  id             Int     @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  observaciones  String? @db.VarChar(300)

  pedidoId   Int
  productoId Int

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  comandas DetalleComanda[]

  @@index([pedidoId])
  @@index([productoId])
}

model Comanda {
  id Int @id @default(autoincrement())

  estado EstadoComanda @default(PENDIENTE)
  prioridad PrioridadComanda @default(NORMAL)

  fechaEnvio   DateTime  @default(now())
  fechaInicio  DateTime?
  fechaLista   DateTime?
  fechaEntrega DateTime?

  pedidoId Int
  estacionId Int

  pedido   Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  estacion EstacionPreparacion @relation(fields: [estacionId], references: [id], onDelete: Restrict)
  detalles DetalleComanda[]

  @@index([pedidoId])
  @@index([estacionId, estado, prioridad])
  @@index([estado])
  @@index([fechaEnvio])
}

model DetalleComanda {
  id Int @id @default(autoincrement())

  cantidad Int

  comandaId       Int
  detallePedidoId Int

  comanda       Comanda       @relation(fields: [comandaId], references: [id], onDelete: Restrict)
  detallePedido DetallePedido @relation(fields: [detallePedidoId], references: [id], onDelete: Restrict)

  @@unique([comandaId, detallePedidoId])
  @@index([comandaId])
  @@index([detallePedidoId])
}

model Venta {
  id Int @id @default(autoincrement())

  origen OrigenVenta @default(PEDIDO)
  estado EstadoVenta @default(PENDIENTE_PAGO)

  subtotal       Decimal @db.Decimal(12, 2)
  descuentos     Decimal @default(0) @db.Decimal(12, 2)
  impuestos      Decimal @default(0) @db.Decimal(12, 2)
  impoconsumo    Decimal @default(0) @db.Decimal(12, 2)
  propina        Decimal @default(0) @db.Decimal(12, 2)
  domicilioCosto Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  // Momento real en que ocurrió la venta.
  fechaOperacion     DateTime
  numeroComandaPapel String?  @db.VarChar(80)
  numeroSoporte      String?  @db.VarChar(80)
  soporteArchivoRef  String?  @db.VarChar(500)

  idempotenciaClave String? @db.VarChar(100)
  idempotenciaHash  String? @db.VarChar(64)

  // Momento en que fue registrada/modificada en SIGR.
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sucursalId Int
  usuarioId  Int
  pedidoId   Int? @unique
  clienteId  Int?

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id])
  cliente  Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  detalles              DetalleVenta[]
  pagos                 Pago[]
  factura               Factura?
  registrosFactura      RegistroFacturaOperativa[]
  movimientosInventario MovimientoInventario[]

  @@unique([sucursalId, idempotenciaClave])
  @@unique([sucursalId, numeroComandaPapel])
  @@unique([sucursalId, numeroSoporte])
  @@index([sucursalId])
  @@index([usuarioId])
  @@index([clienteId])
  @@index([fechaOperacion])
  @@index([estado])
}

model DetalleVenta {
  id Int @id @default(autoincrement())

  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  ventaId    Int
  productoId Int

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@index([productoId])
}

// ==========================================
// FASE 4: INVENTARIOS Y RECETAS
// ==========================================

model Articulo {
  id          Int              @id @default(autoincrement())
  nombre      String           @db.VarChar(100)
  unidad      UnidadInventario @default(UNIDAD)
  costoUnidad Decimal          @db.Decimal(10, 2)
  stock       Decimal          @db.Decimal(14, 4)
  estado      Boolean          @default(true)
  creadoEn    DateTime         @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  recetas               Receta[]
  movimientosInventario MovimientoInventario[]
}

model Receta {
  id       Int              @id @default(autoincrement())
  cantidad Decimal          @db.Decimal(14, 4)
  unidad   UnidadInventario

  productoId Int
  articuloId Int

  producto Producto @relation(fields: [productoId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@unique([productoId, articuloId])
}

model MovimientoInventario {
  id Int @id @default(autoincrement())

  tipo     TipoMovimientoInventario
  cantidad Decimal                  @db.Decimal(14, 4)
  unidad   UnidadInventario

  stockAnterior Decimal @db.Decimal(14, 4)
  stockNuevo    Decimal @db.Decimal(14, 4)

  motivo   String?  @db.VarChar(250)
  creadoEn DateTime @default(now())

  sucursalId Int
  usuarioId  Int
  ventaId    Int?
  productoId Int?
  articuloId Int?

  movimientoOrigenId Int? @unique

  sucursal Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  venta    Venta?    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: Restrict)
  articulo Articulo? @relation(fields: [articuloId], references: [id], onDelete: Restrict)

  movimientoOrigen    MovimientoInventario?  @relation("ReversionMovimientoInventario", fields: [movimientoOrigenId], references: [id], onDelete: Restrict)
  movimientosReversos MovimientoInventario[] @relation("ReversionMovimientoInventario")

  @@index([sucursalId])
  @@index([usuarioId])
  @@index([ventaId])
  @@index([productoId])
  @@index([articuloId])
  @@index([tipo])
  @@index([creadoEn])
}

// ==========================================
// FASE 5: FACTURACIÓN Y PAGOS
// ==========================================

model MetodoPago {
  id     Int            @id @default(autoincrement())
  nombre String         @db.VarChar(50)
  tipo   TipoMetodoPago @default(OTRO)
  activo Boolean        @default(true)

  pagos Pago[]

  @@index([tipo])
}

model Factura {
  id             Int      @id @default(autoincrement())
  numero         String   @unique @db.VarChar(50)
  total          Decimal  @db.Decimal(12, 2)
  cufe           String?  @db.VarChar(150)
  qrCode         String?  @db.Text
  resolucionDian String?  @db.VarChar(100)
  estado         String   @default("EMITIDA")
  creadoEn       DateTime @default(now())

  /**
   * Relación heredada.
   * Se mantiene opcional para facturas provenientes
   * del flujo antiguo Pedido -> Factura.
   */
  pedidoId Int?    @unique
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  /**
   * Relación comercial principal.
   */
  ventaId Int?   @unique
  venta   Venta? @relation(fields: [ventaId], references: [id])

  /**
   * Documento electrónico separado de la factura.
   * Crear una factura NO implica crear ni enviar
   * automáticamente un documento electrónico.
   */
  documentoElectronico DocumentoElectronico?

  pagos             Pago[]
  registroOperativo RegistroFacturaOperativa?
}

model RegistroFacturaOperativa {
  id                Int                   @id @default(autoincrement())
  numero            String                @db.VarChar(80)
  numeroComanda     String?               @db.VarChar(80)
  numeroSoporte     String?               @db.VarChar(80)
  origen            OrigenRegistroFactura
  fechaOperacion    DateTime
  subtotal          Decimal               @db.Decimal(14, 2)
  descuentos        Decimal               @default(0) @db.Decimal(14, 2)
  impuestos         Decimal               @default(0) @db.Decimal(14, 2)
  propina           Decimal               @default(0) @db.Decimal(14, 2)
  domicilio         Decimal               @default(0) @db.Decimal(14, 2)
  total             Decimal               @db.Decimal(14, 2)
  detalles          Json
  impuestosDetalle  Json?
  formasPago        Json?
  soporteArchivoRef String?               @db.VarChar(500)
  observaciones     String?               @db.VarChar(500)
  idempotenciaClave String?               @db.VarChar(100)
  creadoEn          DateTime              @default(now())
  actualizadoEn     DateTime              @updatedAt

  restauranteId Int
  sucursalId    Int
  digitadoPorId Int
  ventaId       Int?
  facturaId     Int? @unique

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  sucursal    Sucursal    @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  digitadoPor Usuario     @relation(fields: [digitadoPorId], references: [id], onDelete: Restrict)
  venta       Venta?      @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  factura     Factura?    @relation(fields: [facturaId], references: [id], onDelete: SetNull)

  @@unique([sucursalId, numero])
  @@unique([sucursalId, numeroComanda])
  @@unique([sucursalId, numeroSoporte])
  @@unique([sucursalId, idempotenciaClave])
  @@index([restauranteId, fechaOperacion])
  @@index([sucursalId, fechaOperacion])
  @@index([digitadoPorId])
  @@index([ventaId])
}

model Pago {
  id         Int      @id @default(autoincrement())
  monto      Decimal  @db.Decimal(12, 2)
  referencia String?  @db.VarChar(150)
  creadoEn   DateTime @default(now())

  idempotenciaClave String? @db.VarChar(100)
  idempotenciaHash  String? @db.VarChar(64)

  metodoPagoId Int

  /**
   * Relación heredada.
   * Se conserva temporalmente para no romper
   * las facturas y pagos existentes.
   */
  facturaId Int?

  /**
   * Relación comercial principal.
   */
  ventaId Int?

  /**
   * Desde Sprint 5, los nuevos pagos pueden
   * asociarse a la sesión de caja que los recibió
   * y al usuario que los registró.
   * Se mantienen opcionales para compatibilidad
   * con pagos creados antes de Caja.
   */
  cajaId    Int?
  usuarioId Int?

  factura    Factura?   @relation(fields: [facturaId], references: [id])
  venta      Venta?     @relation(fields: [ventaId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])
  caja       Caja?      @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([ventaId, idempotenciaClave])
  @@index([facturaId])
  @@index([ventaId])
  @@index([metodoPagoId])
  @@index([cajaId])
  @@index([usuarioId])
}

// ==========================================
// SPRINT 5: CAJA Y CUADRE OPERATIVO
// ==========================================

model Caja {
  id     Int        @id @default(autoincrement())
  nombre String     @db.VarChar(80)
  estado EstadoCaja @default(ABIERTA)

  saldoInicial  Decimal  @db.Decimal(12, 2)
  saldoEsperado Decimal? @db.Decimal(12, 2)
  saldoContado  Decimal? @db.Decimal(12, 2)
  diferencia    Decimal? @db.Decimal(12, 2)

  totalEfectivoSistema Decimal? @db.Decimal(12, 2)
  totalOtrosPagos      Decimal? @db.Decimal(12, 2)
  totalIngresos        Decimal? @db.Decimal(12, 2)
  totalEgresos         Decimal? @db.Decimal(12, 2)

  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?

  observacionApertura String? @db.VarChar(250)
  observacionCierre   String? @db.VarChar(250)

  sucursalId   Int
  abiertaPorId Int
  cerradaPorId Int?

  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  abiertaPor Usuario  @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id], onDelete: Restrict)
  cerradaPor Usuario? @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: Restrict)

  movimientos MovimientoCaja[]
  pagos       Pago[]

  @@index([sucursalId])
  @@index([estado])
  @@index([fechaApertura])
  @@index([abiertaPorId])
  @@index([cerradaPorId])
}

model MovimientoCaja {
  id          Int                @id @default(autoincrement())
  tipo        TipoMovimientoCaja
  monto       Decimal            @db.Decimal(12, 2)
  concepto    String             @db.VarChar(120)
  observacion String?            @db.VarChar(250)
  creadoEn    DateTime           @default(now())

  cajaId    Int
  usuarioId Int

  caja    Caja    @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([cajaId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([creadoEn])
}

// ==========================================
// SPRINT 2: PLANES Y CAPACIDADES SAAS
// ==========================================

model Plan {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(30)
  nombre        String   @db.VarChar(60)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  restaurantes Restaurante[]
  capacidades  PlanCapacidad[]
}

model Capacidad {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  modulo      String?  @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  planes PlanCapacidad[]
}

model PlanCapacidad {
  planId      Int
  capacidadId Int

  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  capacidad Capacidad @relation(fields: [capacidadId], references: [id], onDelete: Cascade)

  @@id([planId, capacidadId])
  @@index([capacidadId])
}

// ==========================================
// SPRINT 2: PERMISOS GRANULARES
// ==========================================

model Permiso {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(80)
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.Text
  modulo      String   @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  roles RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
}

// ==========================================
// SPRINT 8: AUDITORIA INMUTABLE
// ==========================================

model EventoAuditoria {
  id             BigInt   @id @default(autoincrement())
  accion         String   @db.VarChar(80)
  recurso        String   @db.VarChar(80)
  recursoId      String?  @db.VarChar(100)
  actorEmail     String   @db.VarChar(150)
  valoresAntes   Json?
  valoresDespues Json?
  ip             String?  @db.VarChar(64)
  agenteUsuario  String?  @db.VarChar(300)
  correlacionId  String   @db.VarChar(100)
  creadoEn       DateTime @default(now())

  actorId       Int?
  restauranteId Int?
  sucursalId    Int?

  actor       Usuario?     @relation("AuditoriaActor", fields: [actorId], references: [id], onDelete: SetNull)
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id], onDelete: SetNull)
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id], onDelete: SetNull)

  @@index([restauranteId, creadoEn])
  @@index([sucursalId, creadoEn])
  @@index([actorId, creadoEn])
  @@index([recurso, recursoId])
  @@index([accion])
  @@index([correlacionId])
}

// ==========================================
// SPRINT 3: DOCUMENTO ELECTRÓNICO
// ==========================================

model DocumentoElectronico {
  id Int @id @default(autoincrement())

  estado         EstadoDocumentoElectronico @default(PREPARADO)
  tipo           TipoDocumentoFiscal        @default(FACTURA_VENTA)
  ambiente       AmbienteDian?
  prefijo        String?                    @db.VarChar(20)
  numeroFiscal   Int?
  numeroCompleto String?                    @db.VarChar(50)

  /**
   * Datos fiscales.
   * Estos campos solamente deben completarse
   * cuando exista una respuesta REAL del
   * proveedor electrónico / DIAN.
   */
  cufe   String?
  qrCode String?

  /**
   * Respuesta técnica original del proveedor.
   * No debe utilizarse para fabricar una
   * aceptación electrónica ficticia.
   */
  respuestaProveedor  Json?
  solicitudProveedor  Json?
  xmlHash             String? @db.VarChar(64)
  proveedorCodigo     String? @db.VarChar(50)
  proveedorReferencia String? @db.VarChar(150)
  mensajeEstado       String? @db.VarChar(500)

  enviadoEn    DateTime?
  respondidoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  /**
   * Relación 1:1.
   * Una factura puede tener como máximo
   * un documento electrónico asociado.
   */
  facturaId    Int                        @unique
  factura      Factura                    @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  resolucionId Int?
  resolucion   ResolucionNumeracionDian?  @relation(fields: [resolucionId], references: [id], onDelete: Restrict)
  outbox       OutboxFiscal?
  historial    HistorialDocumentoFiscal[]

  @@unique([resolucionId, numeroFiscal])
  @@index([estado])
  @@index([creadoEn])
  @@index([proveedorReferencia])
}

model PerfilFiscal {
  id                    Int               @id @default(autoincrement())
  ambiente              AmbienteDian      @default(HABILITACION)
  modoOperacion         ModoOperacionDian @default(PROVEEDOR_TECNOLOGICO)
  proveedorCodigo       String?           @db.VarChar(50)
  responsabilidadFiscal String            @db.VarChar(20)
  municipioCodigo       String            @db.VarChar(10)
  actividadEconomica    String?           @db.VarChar(20)
  softwareIdRef         String?           @db.VarChar(150)
  credencialRef         String?           @db.VarChar(150)
  certificadoRef        String?           @db.VarChar(150)
  activo                Boolean           @default(false)
  creadoEn              DateTime          @default(now())
  actualizadoEn         DateTime          @updatedAt
  restauranteId         Int               @unique
  restaurante           Restaurante       @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
}

model ResolucionNumeracionDian {
  id               Int                    @id @default(autoincrement())
  numeroResolucion String                 @db.VarChar(100)
  prefijo          String                 @db.VarChar(20)
  rangoDesde       Int
  rangoHasta       Int
  siguienteNumero  Int
  claveTecnicaRef  String?                @db.VarChar(150)
  vigenteDesde     DateTime               @db.Date
  vigenteHasta     DateTime               @db.Date
  activa           Boolean                @default(true)
  creadoEn         DateTime               @default(now())
  actualizadoEn    DateTime               @updatedAt
  restauranteId    Int
  sucursalId       Int?
  restaurante      Restaurante            @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  sucursal         Sucursal?              @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  documentos       DocumentoElectronico[]

  @@unique([restauranteId, prefijo, numeroResolucion])
  @@index([restauranteId, activa])
  @@index([sucursalId])
}

model OutboxFiscal {
  id            Int                  @id @default(autoincrement())
  estado        EstadoOutboxFiscal   @default(PENDIENTE)
  intentos      Int                  @default(0)
  disponibleEn  DateTime             @default(now())
  bloqueadoEn   DateTime?
  ultimoError   String?              @db.VarChar(500)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  documentoId   Int                  @unique
  documento     DocumentoElectronico @relation(fields: [documentoId], references: [id], onDelete: Restrict)

  @@index([estado, disponibleEn])
}

model HistorialDocumentoFiscal {
  id            Int                        @id @default(autoincrement())
  estado        EstadoDocumentoElectronico
  detalle       String?                    @db.VarChar(500)
  actorId       Int?
  correlacionId String?                    @db.VarChar(100)
  creadoEn      DateTime                   @default(now())
  documentoId   Int
  documento     DocumentoElectronico       @relation(fields: [documentoId], references: [id], onDelete: Restrict)

  @@index([documentoId, creadoEn])
}
