generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  RESERVADA
  PENDIENTE_PAGO
  FUERA_SERVICIO
}

enum TipoPedido {
  MESA
  PARA_LLEVAR
  DOMICILIO
  MOSTRADOR
  MANUAL
}

enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  FACTURADO
  CANCELADO
}

model Restaurante {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  nit           String   @unique @db.VarChar(20)
  direccion     String?  @db.VarChar(200)
  telefono      String?  @db.VarChar(20)
  correo        String?  @db.VarChar(150)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  planId Int?
  plan   Plan? @relation(fields: [planId], references: [id])

  sucursales Sucursal[]
  usuarios   Usuario[]

  @@index([planId])
}

model Sucursal {
  id            Int         @id @default(autoincrement())
  nombre        String      @db.VarChar(100)
  direccion     String?     @db.VarChar(200)
  telefono      String?     @db.VarChar(20)
  estado        Boolean     @default(true)
  creadoEn      DateTime    @default(now())
  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  usuarios      Usuario[]
  zonas         Zona[]
  categorias    Categoria[]
  articulos     Articulo[] // <-- RELACIÓN FASE 4 AÑADIDA
  pedidos       Pedido[]
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.Text

  usuarios Usuario[]
  permisos RolPermiso[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  email     String  @unique @db.VarChar(150)
  password  String  @db.VarChar(255)
  activo    Boolean @default(true)

  rolId         Int
  restauranteId Int?
  sucursalId    Int?

  creadoEn DateTime @default(now())

  rol         Rol          @relation(fields: [rolId], references: [id])
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id])
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id])

  pedidos Pedido[]

  @@index([restauranteId])
  @@index([sucursalId])
}

model Zona {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(50)
  estado     Boolean  @default(true)
  creadoEn   DateTime @default(now())
  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  mesas      Mesa[]
}

model Mesa {
  id        Int        @id @default(autoincrement())
  numero    String     @db.VarChar(10)
  capacidad Int        @default(4)
  situacion EstadoMesa @default(LIBRE)
  estado    Boolean    @default(true)
  creadoEn  DateTime   @default(now())
  zonaId    Int
  zona      Zona       @relation(fields: [zonaId], references: [id])
  pedidos   Pedido[]
}

model Categoria {
  id         Int        @id @default(autoincrement())
  nombre     String     @db.VarChar(50)
  estado     Boolean    @default(true)
  creadoEn   DateTime   @default(now())
  sucursalId Int
  sucursal   Sucursal   @relation(fields: [sucursalId], references: [id])
  productos  Producto[]
}

model Producto {
  id          Int             @id @default(autoincrement())
  nombre      String          @db.VarChar(100)
  descripcion String?         @db.Text
  precio      Decimal         @db.Decimal(10, 2)
  stock       Int?
  estado      Boolean         @default(true)
  creadoEn    DateTime        @default(now())
  categoriaId Int
  categoria   Categoria       @relation(fields: [categoriaId], references: [id])
  detalles    DetallePedido[]
  recetas     Receta[] // <-- RELACIÓN FASE 4 AÑADIDA
}

model Pedido {
  id       Int          @id @default(autoincrement())
  total    Decimal      @db.Decimal(10, 2)
  tipo     TipoPedido   @default(MESA)
  estado   EstadoPedido @default(PENDIENTE)
  creadoEn DateTime     @default(now())

  sucursalId Int
  mesaId     Int?
  usuarioId  Int

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  mesa     Mesa?    @relation(fields: [mesaId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  detalles DetallePedido[]
  factura  Factura?
}

model DetallePedido {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  pedidoId       Int
  productoId     Int
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  producto       Producto @relation(fields: [productoId], references: [id])
}

// ==========================================
// FASE 4: INVENTARIOS Y RECETAS
// ==========================================

model Articulo {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  unidad      String   @db.VarChar(20) // ej: gramos, mililitros, unidades
  costoUnidad Decimal  @db.Decimal(10, 2)
  stock       Decimal  @db.Decimal(10, 2)
  estado      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  // Relaciones
  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  recetas    Receta[]
}

model Receta {
  id       Int     @id @default(autoincrement())
  cantidad Decimal @db.Decimal(10, 2) // Cuánto de este artículo usa el producto

  // Relaciones
  productoId Int
  articuloId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  articulo   Articulo @relation(fields: [articuloId], references: [id])

  // Restricción: Un producto no puede tener el mismo artículo dos veces en su receta
  @@unique([productoId, articuloId])
}

// ==========================================
// FASE 5: FACTURACIÓN Y PAGOS (DIAN)
// ==========================================

model MetodoPago {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(50) // Ej: Efectivo, Tarjeta, Nequi, DaviPlata
  activo Boolean @default(true)
  pagos  Pago[]
}

model Factura {
  id             Int      @id @default(autoincrement())
  numero         String   @unique @db.VarChar(50) // Prefijo + consecutivo (Ej: SET-1)
  total          Decimal  @db.Decimal(10, 2)
  cufe           String?  @db.VarChar(150) // Código Único de Factura Electrónica (DIAN)
  qrCode         String?  @db.Text
  resolucionDian String?  @db.VarChar(100)
  estado         String   @default("EMITIDA") // EMITIDA, ANULADA
  creadoEn       DateTime @default(now())

  // Relaciones
  pedidoId Int    @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id])
  pagos    Pago[]
}

model Pago {
  id       Int      @id @default(autoincrement())
  monto    Decimal  @db.Decimal(10, 2)
  creadoEn DateTime @default(now())

  // Relaciones
  facturaId    Int
  metodoPagoId Int
  factura      Factura    @relation(fields: [facturaId], references: [id])
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id])
}

// ==========================================
// SPRINT 2: PLANES Y CAPACIDADES SAAS
// ==========================================

model Plan {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(30)
  nombre        String   @db.VarChar(60)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  restaurantes Restaurante[]
  capacidades  PlanCapacidad[]
}

model Capacidad {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  modulo      String?  @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  planes PlanCapacidad[]
}

model PlanCapacidad {
  planId      Int
  capacidadId Int

  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  capacidad Capacidad @relation(fields: [capacidadId], references: [id], onDelete: Cascade)

  @@id([planId, capacidadId])
  @@index([capacidadId])
}

// ==========================================
// SPRINT 2: PERMISOS GRANULARES
// ==========================================

model Permiso {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(80)
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.Text
  modulo      String   @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  roles RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
}
