generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  RESERVADA
  PENDIENTE_PAGO
  FUERA_SERVICIO
}

enum TipoPedido {
  MESA
  PARA_LLEVAR
  DOMICILIO
  MOSTRADOR
  MANUAL
}

enum OrigenVenta {
  PEDIDO
  DIRECTA
  MANUAL_CIERRE
}

enum EstadoVenta {
  PENDIENTE_PAGO
  PAGADA
  ANULADA
}

enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  FACTURADO
  CANCELADO
}

enum AmbitoRol {
  SISTEMA
  RESTAURANTE
}

model Restaurante {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  nit           String   @unique @db.VarChar(20)
  direccion     String?  @db.VarChar(200)
  telefono      String?  @db.VarChar(20)
  correo        String?  @db.VarChar(150)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  planId Int?
  plan   Plan? @relation(fields: [planId], references: [id])

  sucursales Sucursal[]
  usuarios   Usuario[]
  roles      Rol[]

  @@index([planId])
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  direccion String?  @db.VarChar(200)
  telefono  String?  @db.VarChar(20)
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])

  usuarios   Usuario[]
  zonas      Zona[]
  categorias Categoria[]
  articulos  Articulo[]
  pedidos    Pedido[]
  ventas     Venta[]
}

model Rol {
  id          Int     @id @default(autoincrement())
  clave       String  @unique @db.VarChar(120)
  nombre      String  @db.VarChar(50)
  descripcion String? @db.Text

  ambito        AmbitoRol
  restauranteId Int?

  restaurante Restaurante? @relation(fields: [restauranteId], references: [id], onDelete: Restrict)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@unique([restauranteId, nombre])
  @@index([ambito])
  @@index([restauranteId])
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  email     String  @unique @db.VarChar(150)
  password  String  @db.VarChar(255)
  activo    Boolean @default(true)

  rolId         Int
  restauranteId Int?
  sucursalId    Int?

  creadoEn DateTime @default(now())

  rol         Rol          @relation(fields: [rolId], references: [id])
  restaurante Restaurante? @relation(fields: [restauranteId], references: [id])
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id])

  pedidos Pedido[]
  ventas  Venta[]

  @@index([restauranteId])
  @@index([sucursalId])
}

model Zona {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(50)
  estado   Boolean  @default(true)
  creadoEn DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  mesas Mesa[]
}

model Mesa {
  id        Int        @id @default(autoincrement())
  numero    String     @db.VarChar(10)
  capacidad Int        @default(4)
  situacion EstadoMesa @default(LIBRE)
  estado    Boolean    @default(true)
  creadoEn  DateTime   @default(now())

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  pedidos Pedido[]
}

model Categoria {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(50)
  estado   Boolean  @default(true)
  creadoEn DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  productos Producto[]
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  precio      Decimal  @db.Decimal(10, 2)
  stock       Int?
  estado      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  detalles      DetallePedido[]
  detallesVenta DetalleVenta[]
  recetas       Receta[]
}

model Pedido {
  id       Int          @id @default(autoincrement())
  total    Decimal      @db.Decimal(10, 2)
  tipo     TipoPedido   @default(MESA)
  estado   EstadoPedido @default(PENDIENTE)
  creadoEn DateTime     @default(now())

  sucursalId Int
  mesaId     Int?
  usuarioId  Int

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  mesa     Mesa?    @relation(fields: [mesaId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  detalles DetallePedido[]
  factura  Factura?
  venta    Venta?
}

model DetallePedido {
  id             Int     @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  pedidoId   Int
  productoId Int

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
}

model Venta {
  id Int @id @default(autoincrement())

  origen OrigenVenta @default(PEDIDO)
  estado EstadoVenta @default(PENDIENTE_PAGO)

  subtotal    Decimal @db.Decimal(12, 2)
  descuentos  Decimal @default(0) @db.Decimal(12, 2)
  impuestos   Decimal @default(0) @db.Decimal(12, 2)
  impoconsumo Decimal @default(0) @db.Decimal(12, 2)
  propina     Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Momento real en que ocurrió la venta.
  fechaOperacion DateTime

  // Momento en que fue registrada/modificada en SIGR.
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sucursalId Int
  usuarioId  Int
  pedidoId   Int? @unique

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id])

  detalles DetalleVenta[]
  pagos    Pago[]
  factura  Factura?

  @@index([sucursalId])
  @@index([usuarioId])
  @@index([fechaOperacion])
  @@index([estado])
}

model DetalleVenta {
  id Int @id @default(autoincrement())

  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  ventaId    Int
  productoId Int

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@index([productoId])
}

// ==========================================
// FASE 4: INVENTARIOS Y RECETAS
// ==========================================

model Articulo {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  unidad      String   @db.VarChar(20)
  costoUnidad Decimal  @db.Decimal(10, 2)
  stock       Decimal  @db.Decimal(10, 2)
  estado      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  recetas Receta[]
}

model Receta {
  id       Int     @id @default(autoincrement())
  cantidad Decimal @db.Decimal(10, 2)

  productoId Int
  articuloId Int

  producto Producto @relation(fields: [productoId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@unique([productoId, articuloId])
}

// ==========================================
// FASE 5: FACTURACIÓN Y PAGOS
// ==========================================

model MetodoPago {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(50)
  activo Boolean @default(true)

  pagos Pago[]
}

model Factura {
  id             Int      @id @default(autoincrement())
  numero         String   @unique @db.VarChar(50)
  total          Decimal  @db.Decimal(10, 2)
  cufe           String?  @db.VarChar(150)
  qrCode         String?  @db.Text
  resolucionDian String?  @db.VarChar(100)
  estado         String   @default("EMITIDA")
  creadoEn       DateTime @default(now())

  pedidoId Int    @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  /**
   * Relación nueva.
   * Temporalmente opcional mientras migramos
   * el flujo antiguo Pedido -> Factura.
   */
  ventaId Int?   @unique
  venta   Venta? @relation(fields: [ventaId], references: [id])

  pagos Pago[]
}

model Pago {
  id       Int      @id @default(autoincrement())
  monto    Decimal  @db.Decimal(12, 2)
  creadoEn DateTime @default(now())

  metodoPagoId Int

  /**
   * Relación heredada.
   * Se conserva temporalmente para no romper
   * las facturas y pagos existentes.
   */
  facturaId Int?

  /**
   * Nueva relación comercial principal.
   */
  ventaId Int?

  factura    Factura?   @relation(fields: [facturaId], references: [id])
  venta      Venta?     @relation(fields: [ventaId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])

  @@index([facturaId])
  @@index([ventaId])
  @@index([metodoPagoId])
}

// ==========================================
// SPRINT 2: PLANES Y CAPACIDADES SAAS
// ==========================================

model Plan {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(30)
  nombre        String   @db.VarChar(60)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  restaurantes Restaurante[]
  capacidades  PlanCapacidad[]
}

model Capacidad {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  modulo      String?  @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  planes PlanCapacidad[]
}

model PlanCapacidad {
  planId      Int
  capacidadId Int

  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  capacidad Capacidad @relation(fields: [capacidadId], references: [id], onDelete: Cascade)

  @@id([planId, capacidadId])
  @@index([capacidadId])
}

// ==========================================
// SPRINT 2: PERMISOS GRANULARES
// ==========================================

model Permiso {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique @db.VarChar(80)
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.Text
  modulo      String   @db.VarChar(50)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  roles RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
}
