# SIGR Cloud. NO guardar este archivo real en Git.
# En producciÃ³n CLOUD_DOMAIN debe apuntar por DNS a la IP pÃºblica del VPS.
CLOUD_DOMAIN=app.ejemplo-sigr.com
ACME_EMAIL=admin@ejemplo-sigr.com
CLOUD_HTTP_PORT=80
CLOUD_HTTPS_PORT=443

POSTGRES_USER=admin_sigr
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_LARGO_Y_UNICO
POSTGRES_DB=sigr_db

JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
JWT_EXPIRES_IN=12h
CORS_ORIGINS=https://app.ejemplo-sigr.com
TIME_ZONE=America/Bogota
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
METRICS_ENABLED=true

# Sprint 48D: Cloud recibe push/pull autenticado por peer registrado en SyncPeer.
SYNC_ENABLED=true
SYNC_ROLE=CLOUD
SYNC_NODE_ID=cloud
SYNC_POLL_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
SYNC_CERTIFICATION_ENABLED=false
# DistribuciÃ³n automÃ¡tica de reportes de cierre.
# Los secretos reales se configuran sÃ³lo en el servidor/EDGE; no se guardan en frontend.
CIERRE_SMTP_HOST=
CIERRE_SMTP_PORT=587
CIERRE_SMTP_SECURE=false
CIERRE_SMTP_STARTTLS=true
CIERRE_SMTP_USER=
CIERRE_SMTP_PASS=
CIERRE_SMTP_FROM=

# Adaptador desacoplado para WhatsApp. Queda pendiente conectar el proveedor real.
CIERRE_WHATSAPP_BRIDGE_URL=
CIERRE_WHATSAPP_BRIDGE_TOKEN=
