{
    email {$ACME_EMAIL}
    admin off
}

{$CLOUD_DOMAIN} {
    encode zstd gzip

    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy backend:3000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    handle {
        reverse_proxy frontend:80
    }

    log {
        output stdout
        format console
    }
}
