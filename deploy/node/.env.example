# SIGR Local Node. Copiar como deploy/node/.env o ejecutar scripts/configurar-node-local.ps1
POSTGRES_USER=admin_sigr
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=sigr_db
POSTGRES_PORT=5433
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_32_CARACTERES_O_MAS
JWT_EXPIRES_IN=12h
CORS_ORIGINS=https://sigr.local
TIME_ZONE=America/Bogota
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
METRICS_ENABLED=true
NODE_HTTP_PORT=8080

# Sprint 48D: en el restaurante EDGE se conecta hacia Cloud; Cloud nunca abre conexion al PC.
SYNC_ENABLED=false
SYNC_ROLE=EDGE
SYNC_NODE_ID=edge-sucursal-001
SYNC_PEER_URL=https://app.ejemplo-sigr.com/api
SYNC_PEER_NODE_ID=cloud
SYNC_PEER_KEY=CAMBIAR_POR_CLAVE_UNICA_DE_ESTA_SUCURSAL_32_CHARS_MIN
SYNC_POLL_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
SYNC_CERTIFICATION_ENABLED=false

# MenÃº QR pÃºblico (Cloudflare Worker + KV). El EDGE sÃ³lo publica hacia Internet.
PUBLIC_MENU_BASE_URL=
PUBLIC_MENU_PUBLISH_TOKEN=
PUBLIC_MENU_INTERVAL_MS=60000

# Bloque 5C Â· PIN privado de plataforma para polÃ­tica de documentos internos.
# SHA-256 hex de: JWT_SECRET + ":" + PIN. El PIN real nunca se guarda aquÃ­.
PLATFORM_ADMIN_PIN_HASH=
# DistribuciÃ³n automÃ¡tica de reportes de cierre.
# Los secretos reales se configuran sÃ³lo en el servidor/EDGE; no se guardan en frontend.
CIERRE_SMTP_HOST=
CIERRE_SMTP_PORT=587
CIERRE_SMTP_SECURE=false
CIERRE_SMTP_STARTTLS=true
CIERRE_SMTP_USER=
CIERRE_SMTP_PASS=
CIERRE_SMTP_FROM=

# Adaptador desacoplado para WhatsApp. Queda pendiente conectar el proveedor real.
CIERRE_WHATSAPP_BRIDGE_URL=
CIERRE_WHATSAPP_BRIDGE_TOKEN=
